---
// Renders an amenity icon by ID. Known IDs get hand-drawn SVGs; unknown
// (custom amenities) get a generic placeholder icon.
interface Props {
  id: string;
  label?: string;
}
const { id, label } = Astro.props;
const lower = id?.toLowerCase().trim();
---

<div class="am-i">
  <div class="am-i-icon">
    {lower === 'pileta' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M4 22 Q 7 20, 10 22 T 16 22 T 22 22 T 28 22"/>
        <path d="M4 26 Q 7 24, 10 26 T 16 26 T 22 26 T 28 26"/>
        <path d="M7 9 L 7 22"/>
        <path d="M25 9 L 25 22"/>
        <path d="M7 11 L 25 11"/>
        <path d="M7 15 L 25 15"/>
      </svg>
    )}
    {lower === 'parrilla' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
        <path d="M5 9 L 27 9 L 23 21 L 9 21 Z"/>
        <path d="M9 13 L 23 13"/>
        <path d="M13 21 L 13 27"/>
        <path d="M19 21 L 19 27"/>
        <path d="M10 27 L 22 27"/>
      </svg>
    )}
    {lower === 'sum' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
        <rect x="4" y="7" width="24" height="20"/>
        <path d="M4 13 L 28 13"/>
        <circle cx="10" cy="20" r="1.5"/>
        <circle cx="16" cy="20" r="1.5"/>
        <circle cx="22" cy="20" r="1.5"/>
      </svg>
    )}
    {lower === 'gimnasio' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="13" width="3" height="6" rx="0.5"/>
        <rect x="27" y="13" width="3" height="6" rx="0.5"/>
        <rect x="5" y="10" width="3" height="12" rx="0.5"/>
        <rect x="24" y="10" width="3" height="12" rx="0.5"/>
        <line x1="8" y1="16" x2="24" y2="16"/>
      </svg>
    )}
    {lower === 'spa' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 4 Q 8 7, 10 10 Q 12 13, 10 16"/>
        <path d="M16 3 Q 14 6, 16 9 Q 18 12, 16 15"/>
        <path d="M22 4 Q 20 7, 22 10 Q 24 13, 22 16"/>
        <path d="M4 19 L 28 19 Q 28 27, 16 28 Q 4 27, 4 19 Z"/>
      </svg>
    )}
    {lower === 'solarium' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="16" cy="11" r="4"/>
        <path d="M16 3 L 16 5 M 16 17 L 16 19 M 5 11 L 7 11 M 25 11 L 27 11"/>
        <path d="M3 25 L 29 25 M 5 28 L 27 28"/>
      </svg>
    )}
    {lower === 'cocheras' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
        <path d="M6 19 L 6 16 L 9 11 L 23 11 L 26 16 L 26 19"/>
        <rect x="4" y="19" width="24" height="5"/>
        <circle cx="10" cy="24" r="2"/>
        <circle cx="22" cy="24" r="2"/>
      </svg>
    )}
    {lower === 'bicicletero' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="8" cy="22" r="5"/>
        <circle cx="24" cy="22" r="5"/>
        <path d="M8 22 L 14 13 L 22 13 L 24 22"/>
      </svg>
    )}
    {lower === 'lavanderia' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="5" y="4" width="22" height="24" rx="1"/>
        <circle cx="16" cy="18" r="6"/>
        <circle cx="9" cy="9" r="1"/>
      </svg>
    )}
    {lower === 'sauna' && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M5 14 L 27 14 L 27 26 L 5 26 Z"/>
        <path d="M5 18 L 27 18"/>
        <path d="M5 22 L 27 22"/>
        <path d="M12 6 Q 11 9, 12 12"/>
        <path d="M16 5 Q 15 8, 16 11"/>
        <path d="M20 6 Q 19 9, 20 12"/>
      </svg>
    )}
    {/* Generic fallback icon for custom amenities */}
    {!['pileta','parrilla','sum','gimnasio','spa','solarium','cocheras','bicicletero','lavanderia','sauna'].includes(lower) && (
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="16" cy="16" r="11"/>
        <circle cx="16" cy="16" r="2" fill="currentColor"/>
      </svg>
    )}
  </div>
  <div class="am-i-lbl">{label || id}</div>
</div>
